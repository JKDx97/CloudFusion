NODE_ENV=development

API_PORT=3000
FRONTEND_URL=http://localhost:4200

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cloudfusion
DATABASE_USER=cloudfusion
DATABASE_PASSWORD=change_me_local

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_characters
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google Drive OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/cloud-accounts/google/callback

# Microsoft Graph / OneDrive OAuth 2.0
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/cloud-accounts/onedrive/callback
MICROSOFT_TENANT_ID=common

# Dropbox OAuth 2.0 (offline refresh-token access)
PROVIDER_DROPBOX_ENABLED=true
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:3000/cloud-accounts/dropbox/callback

# Box OAuth 2.0 (configure Read and write all files/folders in the Box app)
PROVIDER_BOX_ENABLED=true
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REDIRECT_URI=http://localhost:3000/cloud-accounts/box/callback

# 32 bytes encoded as base64 or 64 hexadecimal characters.
CLOUD_TOKEN_ENCRYPTION_KEY=

# Upload and temporary OAuth state settings
CLOUD_UPLOAD_MAX_BYTES=52428800
CLOUD_OAUTH_STATE_TTL_SECONDS=600

# Fase 7: invitaciones de compartición (sin SMTP; el token se devuelve una sola vez)
SHARE_INVITATION_EXPIRY_DAYS=7

# Fase 7: enlaces públicos
PUBLIC_SHARE_DEFAULT_EXPIRY_DAYS=7

# Fase 6: tokens de API y WebDAV
API_TOKEN_DEFAULT_EXPIRY_DAYS=90
WEBDAV_ENABLED=true
# Set only behind a trusted reverse proxy; use its hop count or trusted IP/subnet.
# TRUST_PROXY=loopback

# Transfer queue and worker
TRANSFER_QUEUE_NAME=cloudfusion-transfers
TRANSFER_WORKER_ENABLED=true
TRANSFER_WORKER_CONCURRENCY=3
TRANSFER_MAX_RETRIES=3
TRANSFER_PROGRESS_INTERVAL_MS=1000

# CloudFusion Drive / virtual storage
DEFAULT_REPLICATION_FACTOR=1
REPLICA_AUTO_REPAIR=true
REPLICA_VERIFY_INTERVAL_HOURS=24
REPLICATION_WORKER_CONCURRENCY=2
TRASH_RETENTION_DAYS=30
STORAGE_REBALANCE_ENABLED=true
REPLICATION_QUEUE_NAME=cloudfusion-replication
REPLICATION_WORKER_ENABLED=true

# Fase 5: envelope encryption (32 bytes base64 o 64 caracteres hex)
CLOUDFUSION_MASTER_KEY=
CLOUDFUSION_KEY_VERSION=1
# Optional versioned keyring for key rotation, e.g. {"1":"<base64>","2":"<base64>"}
CLOUDFUSION_MASTER_KEYS_JSON=

# Fase 5: versionado y protección
DEFAULT_VERSION_RETENTION_MODE=KEEP_LAST_N
DEFAULT_VERSION_RETENTION_COUNT=10
SNAPSHOT_SCHEDULER_ENABLED=true
EMERGENCY_SNAPSHOT_ENABLED=true
MASS_CHANGE_WINDOW_SECONDS=120
MASS_CHANGE_THRESHOLD=250
MASS_CHANGE_SCAN_INTERVAL_SECONDS=30
STORAGE_GC_ENABLED=true
STORAGE_GC_GRACE_HOURS=24
STORAGE_GC_INTERVAL_MINUTES=60
SNAPSHOT_RESTORE_QUEUE_NAME=cloudfusion-snapshot-restores
SNAPSHOT_RESTORE_WORKER_ENABLED=true
SNAPSHOT_RESTORE_WORKER_CONCURRENCY=1
SNAPSHOT_RESTORE_MAX_RETRIES=3
BACKUP_WORKER_CONCURRENCY=2
BACKUP_MAX_RETRIES=3
BACKUP_QUEUE_NAME=cloudfusion-backups
BACKUP_WORKER_ENABLED=true
BACKUP_SCHEDULE_INTERVAL_SECONDS=30

# Fase 8: permitir endpoints S3 en redes privadas (NAS/MinIO de confianza).
# Mantener desactivado en despliegues públicos salvo que la red esté controlada.
PROVIDER_CUSTOM_S3_ALLOW_PRIVATE_ENDPOINTS=false
