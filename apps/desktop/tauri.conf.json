{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudFusion",
  "version": "0.1.0",
  "identifier": "com.cloudfusion.desktop",
  "build": {
    "devUrl": "http://localhost:4200",
    "frontendDist": "../web/dist/web/browser"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CloudFusion",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost http://localhost:3000; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../web/public/favicon.ico"]
  }
}
